# Database connection string
# Local dev: a plain SQLite file.
DATABASE_URL=file:./payload.db
# Production (Vercel): a hosted Turso libSQL URL, e.g. libsql://your-db-name.turso.io
#DATABASE_URL=libsql://your-db-name.turso.io

# Turso auth token — REQUIRED in production (Vercel), leave empty for the local file DB.
DATABASE_AUTH_TOKEN=

# Vercel Blob storage token — REQUIRED in production for media uploads.
# When empty (local dev), uploads are written to public/media on disk instead.
BLOB_READ_WRITE_TOKEN=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# Leave unset: locally it falls back to http://localhost:3000, and on Vercel it
# auto-detects VERCEL_PROJECT_PRODUCTION_URL. Only uncomment to force a specific URL.
#NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
